{
  "name": "mailchimp-mcp-server",
  "mcpName": "io.github.cyanheads/mailchimp-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for the Mailchimp Marketing API — audiences, subscribers, campaigns, and reports.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mailchimp-mcp-server": "dist/index.js"
  },
  "files": ["dist/", "README.md", "LICENSE", "CLAUDE.md", "Dockerfile", "server.json"],
  "scripts": {
    "build": "bun scripts/build.ts",
    "rebuild": "bun scripts/clean.ts && bun scripts/build.ts",
    "clean": "bun scripts/clean.ts",
    "devcheck": "bun scripts/devcheck.ts",
    "tree": "bun scripts/tree.ts",
    "format": "biome check --write --unsafe .",
    "lint:mcp": "bun scripts/lint-mcp.ts",
    "test": "vitest run",
    "dev:stdio": "MCP_TRANSPORT_TYPE=stdio bun --watch src/index.ts",
    "dev:http": "MCP_TRANSPORT_TYPE=http bun --watch src/index.ts",
    "start:stdio": "MCP_TRANSPORT_TYPE=stdio node dist/index.js",
    "start:http": "MCP_TRANSPORT_TYPE=http node dist/index.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "mailchimp",
    "mailchimp-api",
    "email-marketing",
    "campaigns",
    "audiences",
    "subscribers",
    "anthropic",
    "claude",
    "typescript",
    "bun"
  ],
  "author": "Casey Hand <caseyjhand@gmail.com> (https://github.com/cyanheads)",
  "homepage": "https://github.com/cyanheads/mailchimp-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/cyanheads/mailchimp-mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanheads/mailchimp-mcp-server.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.11",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cyanheads/mcp-ts-core": "^0.4.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^25.6.0",
    "depcheck": "^1.4.7",
    "ignore": "^7.0.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
